# Ignore everything by default
*

# Don't ignore directories (so we can look inside them, for other files)
!*/

# Don't ignore these
!/*.yaml
!/*.yml
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/fve/fve.yaml
!/requirements-test.txt
!/TESTOVANI.md
!/tools/check.py
!/tests/test_checks.py
# Lokální prostředí a ostatní pracovní kopie nejsou konfigurace projektu.
/.venv/
/.worktrees/
__pycache__/
secrets.yaml
